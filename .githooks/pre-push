#!/bin/sh
# 推送前把遊戲真的開進瀏覽器跑一遍，擋掉會崩潰的改動。
#
# 啟用方式（clone 後跑一次即可，已在 SKILL.md 記錄）：
#   git config core.hooksPath .githooks
#
# 真的要跳過時：git push --no-verify

# pre-push 從 stdin 收到每一條要推的 ref：
#   <local ref> <local sha> <remote ref> <remote sha>
# 發版流程會先推分支、再單獨推 tag。分支那次已經驗過了，
# tag 那次沒必要再等一分鐘，所以純 tag 的推送直接放行。
has_branch=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/tags/*) ;;
    *) has_branch=1 ;;
  esac
done

if [ "$has_branch" -eq 0 ]; then
  echo "pre-push：只推 tag，略過測試。"
  exit 0
fi

echo "pre-push：跑單元測試…"
if ! npm test --silent; then
  echo ""
  echo "❌ 單元測試沒過，推送中止。"
  echo "   真的要推：git push --no-verify"
  exit 1
fi

echo "pre-push：開瀏覽器跑全站冒煙測試（約 1 分鐘）…"
if ! npm run smoke --silent -- --no-shots; then
  echo ""
  echo "❌ 有遊戲在瀏覽器裡噴錯，推送中止。"
  echo "   想看截圖找原因：npm run smoke"
  echo "   真的要推：git push --no-verify"
  exit 1
fi

echo "✅ pre-push 全部通過。"
exit 0
